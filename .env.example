# Все переменные окружения системы. Скопируйте в .env и задайте свои пароли:
#   cp .env.example .env
# .env читают docker compose (подстановка ${...} в docker-compose.yml) и сервисы при локальном
# запуске вне Docker (npm run start:users и т. д.). В контейнерах хосты, порты и пути к ключам
# задаёт docker-compose.yml, остальное берётся отсюда.

# --- сборка образов за прокси с подменой TLS: корневой сертификат прокси для npm ci
# (без прокси не нужен; файл должен лежать внутри проекта, например в secrets/)
# BUILD_CA_FILE=./secrets/proxy-ca.crt

# --- PostgreSQL 18: суперпользователь контейнера postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# --- базы и учётные записи сервисов (db/init/01-databases.sh создаёт их при первом запуске).
# Локально сервис берёт DB_NAME / DB_USER / DB_PASSWORD, а если их нет – <СЕРВИС>_DB_*.
USERS_DB_NAME=users_db
USERS_DB_USER=users_service
USERS_DB_PASSWORD=change-me-users
PETS_DB_NAME=pets_db
PETS_DB_USER=pets_service
PETS_DB_PASSWORD=change-me-pets
CARE_DB_NAME=care_db
CARE_DB_USER=care_service
CARE_DB_PASSWORD=change-me-care
NOTIFICATIONS_DB_NAME=notifications_db
NOTIFICATIONS_DB_USER=notifications_service
NOTIFICATIONS_DB_PASSWORD=change-me-notifications

# --- локальный запуск вне Docker: инфраструктура из compose на localhost
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
# накатывать миграции при старте сервиса
DB_MIGRATIONS_RUN=true
# HTTP-порты сервисов (в контейнерах у всех 3000, PORT задаёт compose)
USERS_PORT=3001
PETS_PORT=3002
CARE_PORT=3003
NOTIFICATIONS_PORT=3004

# --- RabbitMQ 4 (management UI – http://localhost:15672)
RABBITMQ_USER=tamagotchi
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_URL=amqp://tamagotchi:change-me-rabbit@localhost:5672

# --- Redis 7
REDIS_URL=redis://localhost:6379

# --- JWT RS256: npm run keys кладёт пару ключей в secrets/ (папка в .gitignore)
JWT_PUBLIC_KEY_FILE=secrets/jwt-public.pem
# только users-service
JWT_PRIVATE_KEY_FILE=secrets/jwt-private.pem

# --- Silo (S3): ключ доступа – он же логин консоли http://localhost:9001; пароль не короче 8 символов
SILO_ENDPOINT=http://localhost:9000
SILO_ACCESS_KEY=tamagotchi
SILO_SECRET_KEY=change-me-silo
SILO_BUCKET=tamagotchi-media
# адрес Silo в ссылках на картинки, которые получает клиент
SILO_PUBLIC_URL=http://localhost:9000

# --- pets-service: жизнь питомца (§8)
# скорость игрового времени: 1 – реальное время, 60 – час за минуту
GAME_SPEED=1
# период планировщика, мс
TICK_MS=5000
# разрешить перемотку времени POST /api/admin/pets/{petId}/time-travel
DEMO_MODE=true

# --- care-service: gRPC PetCare в pets-service (в compose – pets-service:50051)
PETS_GRPC_URL=localhost:50051

# --- сид users-service: администратор (пароль – 8–64 символа, буквы и цифры)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin1
