{
  "name": "tamagotchi",
  "version": "0.1.0",
  "description": "Серверная часть системы ухода за виртуальными питомцами (тамагочи): монорепозиторий NestJS",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:users && npm run build:pets && npm run build:care && npm run build:notifications",
    "build:users": "nest build users-service",
    "build:pets": "nest build pets-service",
    "build:care": "nest build care-service",
    "build:notifications": "nest build notifications-service",
    "start:users": "nest start users-service --watch",
    "start:pets": "nest start pets-service --watch",
    "start:care": "nest start care-service --watch",
    "start:notifications": "nest start notifications-service --watch",
    "migration:users": "node dist/apps/users-service/apps/users-service/src/migrate.js",
    "migration:pets": "node dist/apps/pets-service/apps/pets-service/src/migrate.js",
    "migration:care": "node dist/apps/care-service/apps/care-service/src/migrate.js",
    "migration:notifications": "node dist/apps/notifications-service/apps/notifications-service/src/migrate.js",
    "seed:users": "node dist/apps/users-service/apps/users-service/src/seed.js",
    "seed:pets": "node dist/apps/pets-service/apps/pets-service/src/seed.js",
    "seed:care": "node dist/apps/care-service/apps/care-service/src/seed.js",
    "openapi": "node scripts/export-openapi.js",
    "openapi:merge": "node scripts/export-openapi.js --merge-only",
    "keys": "node scripts/gen-keys.js",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\"",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" \"scripts/**/*.js\"",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --config test/e2e/jest.config.json --runInBand"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/typeorm": "^12.0.2",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.2.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cockatiel": "^4.0.0",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "jest": {
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src$1",
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src$1"
    },
    "collectCoverageFrom": [
      "{apps,libs}/**/src/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
