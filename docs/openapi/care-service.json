          "happinessDelta": {
            "type": "number",
            "minimum": -4,
            "maximum": 4,
            "example": 0,
            "description": "Изменение настроения, сердечки"
          },
          "weightDelta": {
            "type": "number",
            "minimum": -10,
            "maximum": 10,
            "example": 1,
            "description": "Изменение веса"
          },
          "curesSickness": {
            "type": "boolean",
