{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/users-service",
  "sourceRoot": "apps/users-service/src",
  "compilerOptions": {
    "builder": "tsc",
    "deleteOutDir": true,
    "tsConfigPath": "apps/users-service/tsconfig.app.json"
  },
  "projects": {
    "users-service": {
      "type": "application",
      "root": "apps/users-service",
      "entryFile": "apps/users-service/src/main",
      "sourceRoot": "apps/users-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users-service/tsconfig.app.json"
      }
    },
    "pets-service": {
      "type": "application",
      "root": "apps/pets-service",
      "entryFile": "apps/pets-service/src/main",
      "sourceRoot": "apps/pets-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/pets-service/tsconfig.app.json"
      }
    },
    "care-service": {
      "type": "application",
      "root": "apps/care-service",
      "entryFile": "apps/care-service/src/main",
      "sourceRoot": "apps/care-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/care-service/tsconfig.app.json"
      }
    },
    "notifications-service": {
      "type": "application",
      "root": "apps/notifications-service",
      "entryFile": "apps/notifications-service/src/main",
      "sourceRoot": "apps/notifications-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notifications-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    }
  }
}
