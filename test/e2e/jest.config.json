{
  "rootDir": "../..",
  "roots": ["<rootDir>/test/e2e/"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "testEnvironment": "node",
  "testTimeout": 300000,
  "maxWorkers": 1,
  "verbose": true
}
